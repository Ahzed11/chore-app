# ============================================================
# ChoreApp Backend — environment variables
# Copy this file to .env and fill in real values before running
# ============================================================

# ---- Database -----------------------------------------------
# Full async connection URL for PostgreSQL via asyncpg.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://choreapp:secret@localhost:5432/choreapp

# ---- JWT Authentication -------------------------------------
# Long random secret used to sign JWT tokens. Must be at least 32 characters
# and must not be a placeholder value (the app refuses to start otherwise).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# Signing algorithm (HS256 is the default; do not change unless you know why)
JWT_ALGORITHM=HS256

# Number of minutes before an access token expires. Kept short — sessions are
# kept alive across expiry by the longer-lived refresh token instead.
JWT_EXPIRY_MINUTES=30

# Deprecated: replaced by JWT_EXPIRY_MINUTES above. Leave unset. If set, it is
# still honored (converted to minutes) for backward compatibility, with a
# startup warning — migrate to JWT_EXPIRY_MINUTES instead.
# JWT_EXPIRY_DAYS=7

# ---- Application --------------------------------------------
# Public base URL of the API (used for building absolute links, e.g. invite URLs)
APP_BASE_URL=http://localhost:8000

# ---- Invite tokens ------------------------------------------
# How long (in hours) a household invite link stays valid
INVITE_TOKEN_TTL_HOURS=48

# ---- Scheduler ----------------------------------------------
# Hour of the day (0-23, UTC) at which the nightly scheduler runs
SCHEDULER_RUN_HOUR=0

# ---- Chore instance generation ------------------------------
# How many days ahead to pre-generate chore instances
INSTANCE_GENERATION_DAYS_AHEAD=7

# Backfill grace window (days): after downtime, instance generation starts at
# max(first_due_date, today - GRACE_DAYS) so old definitions cannot flood the
# household with instantly-overdue instances.
GRACE_DAYS=3

# ---- Debug --------------------------------------------------
# Set to true in local development to expose /docs, /redoc, and /openapi.json.
# Must be false (or unset) in production.
DEBUG=true

# ---- CORS ---------------------------------------------------
# Comma-separated list of allowed origins (leave empty for no CORS).
# Example: CORS_ALLOWED_ORIGINS=["http://localhost:3000","https://myapp.com"]
CORS_ALLOWED_ORIGINS=[]

# ---- Tests --------------------------------------------------
# Separate database used exclusively by the test suite.
# Requires a running PostgreSQL instance on port 5433 (see docker-compose.test.yml or run
# a second postgres container manually).
TEST_DATABASE_URL=postgresql+asyncpg://choreapp:testpass@localhost:5433/choreapp_test
