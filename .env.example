# Copy this file to .env and fill in the values.
# Used by both docker-compose.yml (dev) and docker-compose.prod.yml (prod).
# .env is gitignored — never commit real secrets.

# ============================================================
# Required
# ============================================================

# Signing secret for JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_64_char_hex_string

# PostgreSQL password (used by the db, api, and backup services).
# Change this before exposing the app outside localhost.
POSTGRES_PASSWORD=choreapp_dev

# ============================================================
# Production only (docker-compose.prod.yml)
# ============================================================

# api image reference. Defaults to the latest build from the default
# branch. For reproducible deploys, pin a specific tag instead of tracking
# :latest — CI publishes both `:latest` and `:<git-sha>` to GHCR, e.g.:
#   CHORE_APP_IMAGE=ghcr.io/ahzed11/chore-app-api:abc1234
CHORE_APP_IMAGE=ghcr.io/ahzed11/chore-app-api:latest

# Host port the API is published on.
API_PORT=8000

# Client IPs/CIDRs uvicorn trusts to set X-Forwarded-* headers (used with
# --proxy-headers, see README "HTTPS / reverse proxy"). 127.0.0.1 is
# correct when a reverse proxy on the same host talks to API_PORT. If the
# proxy is another container on this compose network instead, set this to
# that container's service name or the docker network's CIDR.
FORWARDED_ALLOW_IPS=127.0.0.1

# Automatic backup schedule/retention for the `backup` service (cron-style
# or the shorthand @daily/@weekly; see README "Backup and restore").
# BACKUP_SCHEDULE=@daily
# BACKUP_KEEP_DAYS=7
# BACKUP_KEEP_WEEKS=4
# BACKUP_KEEP_MONTHS=0

# ============================================================
# Application settings (backend/app/core/config.py)
# All have sane defaults below; uncomment to override.
# ============================================================

# JWT_ALGORITHM=HS256
# Access-token lifetime in minutes (short-lived; the app refreshes
# automatically using the 30-day rotating refresh token).
# JWT_EXPIRY_MINUTES=30
# JWT_EXPIRY_DAYS is deprecated — if set, it overrides JWT_EXPIRY_MINUTES
# and logs a startup warning. Leave unset.
# REFRESH_TOKEN_TTL_DAYS=30

# Public base URL of the API (used to build absolute links, e.g. invite
# URLs). Set this to your real domain in production, e.g.
# https://chores.example.com.
# APP_BASE_URL=http://localhost:8000

# INVITE_TOKEN_TTL_HOURS=48
# SCHEDULER_RUN_HOUR=0
# INSTANCE_GENERATION_DAYS_AHEAD=7

# Set to true only for local development — exposes /docs, /redoc, and
# /openapi.json. docker-compose.prod.yml forces this to false regardless
# of what is set here.
# DEBUG=false

# Comma-separated list of allowed CORS origins as a JSON array string
# (leave as [] if the app never calls the API from a browser).
# CORS_ALLOWED_ORIGINS=[]

# Rate limiting on POST /auth/login, /auth/register, and /auth/refresh,
# keyed per client IP (kept correct behind a reverse proxy by
# FORWARDED_ALLOW_IPS above). In-memory storage — fine for a single-process
# self-host, but resets on restart and isn't shared across worker processes.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_REGISTER=10/hour
# RATE_LIMIT_REFRESH=30/minute
