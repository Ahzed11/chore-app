# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_64_char_hex_string

# PostgreSQL password (used by both the db and api services).
# Change this before exposing the app outside localhost.
POSTGRES_PASSWORD=choreapp_dev
